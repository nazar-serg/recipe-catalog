{
  "model": "main.recipe",
  "pk": 1,
  "fields": {
    "name": "Чізкейк із вершкового сиру, з малиновим прошарком та штрейзелем",
    "preparation_time": 45,
    "complexity": "Важко",
    "description": "Ніжний чізкейк із вершкового сиру з кисло-солодким малиновим прошарком і хрумким штрейзелем. На основу з пісочного печива викладаємо суміш сиру, вершків, яєць та цукру, доповнюємо кисло-солодкою малиною та штрейзелем, а потім випікаємо.",
    "image": "images/maxresdefault.jpg",
    "author": 1,
    "date_created": "2026-09-16T11:38:16.206Z",
    "category": 1
  }
},
{
  "model": "main.recipe",
  "pk": 2,
  "fields": {
    "name": "Арахісовий чізкейк з яблуками",
    "preparation_time": 55,
    "complexity": "Середньо",
    "description": "Сирний чізкейк із додаванням арахісової пасти, а також шару з карамелізованих яблук.",
    "image": "images/images.jpg",
    "author": 1,
    "date_created": "2026-09-16T12:19:47.437Z",
    "category": 1
  }
},
{
  "model": "main.recipe",
  "pk": 4,
  "fields": {
    "name": "Салат із запечених овочів із фетою",
    "preparation_time": 40,
    "complexity": "Легко",
    "description": "Салат із цвітної капусти, болгарського перцю та червоної цибулі з фетою. Овочі запікаються в духовці, завдяки чому салат виходить дуже запашним. Заправляється салат сумішшю оливкової олії, лимонного соку, меду та часнику, а перед подачею доповнюється кубиками солонуватої фети.",
    "image": "images/images_2.jpg",
    "author": 1,
    "date_created": "2026-09-24T07:42:44.333Z",
    "category": 2
  }
},
{
  "model": "main.recipe",
  "pk": 11,
  "fields": {
    "name": "Борщ із яловичиною",
    "preparation_time": 45,
