{
  "model": "main.recipestep",
  "pk": 8,
  "fields": {
    "recipe": 1,
    "number": 2,
    "text": "Подготавливаем продукты. Включаем духовку для разогрева до 180 градусов."
  }
},
{
  "model": "main.recipestep",
  "pk": 9,
  "fields": {
    "recipe": 1,
    "number": 1,
    "text": "Печенье измельчаем в блендере до образования мелкой крошки или натираем на тёрке."
  }
},
{
  "model": "main.recipestep",
  "pk": 10,
  "fields": {
    "recipe": 1,
    "number": 3,
    "text": "Сливочное масло растапливаем и добавляем к измельчённому печенью."
  }
},
{
  "model": "main.recipestep",
  "pk": 11,
  "fields": {
    "recipe": 1,
    "number": 4,
    "text": "Перемешиваем до образования мокрой крошки."
  }
},
{
  "model": "main.recipestep",
  "pk": 12,
  "fields": {
    "recipe": 2,
    "number": 1,
    "text": "Подрібніть пісочне печиво в крихту за допомогою блендера або качалки."
  }
},
{
  "model": "main.recipestep",
  "pk": 13,
  "fields": {
    "recipe": 2,
    "number": 2,
    "text": "Додайте розтоплене вершкове масло і добре перемішайте, щоб массі нагадувала вологий пісок."
  }
},
{
  "model": "main.recipestep",
  "pk": 14,
  "fields": {
    "recipe": 2,
    "number": 3,
    "text": "Щільно утрамбуйте дно та зробіть невеликі бортики за допомогою склянки або ложки. Поставте форму в холодильник на 15–20 хвилин."
  }
},
{
  "model": "main.recipestep",
  "pk": 15,
  "fields": {
    "recipe": 4,
    "number": 1,
    "text": "Підготовка: Овочі помийте та наріжте великими шматочками (чері можна залишити цілими)."
  }
},
{
  "model": "main.recipestep",
  "pk": 16,
  "fields": {
    "recipe": 4,
    "number": 2,
    "text": "Маринування: Змішайте овочі з оливковою олією, сіллю, перцем і травами."
  }
},
{
  "model": "main.recipestep",
  "pk": 17,
  "fields": {
    "recipe": 4,
    "number": 3,
    "text": "Запікання: Викладіть на деко з пергаментом в один шар і запікайте 25–30 хвилин при температурі 210 °C."
  }
},
{
  "model": "main.recipestep",
  "pk": 18,
  "fields": {
    "recipe": 11,
    "number": -1,
    "text": "Підготувати продукти"
  }
},
{
  "model": "main.recipestep",
  "pk": 19,
  "fields": {
    "recipe": 11,
    "number": 2,
    "text": "Яловичину нарізати великими шматками."
  }
},
{
  "model": "main.recipestep",
  "pk": 20,
  "fields": {
    "recipe": 11,
    "number": 3,
    "text": "Залити м'ясо у каструлі холодною водою, довести до кипіння, зняти піну. Варити бульйон приблизно 1,5 години на невеликому вогні."
  }
},
{
  "model": "main.recipestep",
  "pk": 21,
  "fields": {
    "recipe": 12,
    "number": 1,
    "text": "Готують усі необхідні продукти. Якщо чорнослив сухий, заливають окропом на 10-15 хвилин."
  }
},
{
  "model": "main.recipestep",
  "pk": 22,
  "fields": {
    "recipe": 12,
    "number": 2,
    "text": "М'ясо нарізають невеликими шматочками."
  }
},
{
  "model": "main.recipestep",
  "pk": 23,
  "fields": {
    "recipe": 12,
    "number": 3,
    "text": "Викладають м'ясо в каструлю, заливають холодною водою. Доводять до кипіння, знімають піну та варять м'ясо 1,5 години на маленькому вогні, під кришкою."
  }
}
