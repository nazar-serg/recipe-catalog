  }
},
{
  "model": "main.recipe",
  "pk": 12,
  "fields": {
    "name": "Борщ «Класичний»",
    "preparation_time": 55,
    "complexity": "Легко",
    "description": "Кожна господарка впевнена, що вона точно знає, як правильно варити смачний борщ. І серед безлічі рецептів є борщ із чорносливом. Всі інші інгредієнти - як для звичайного, класичного борщу з буряком, але додавання чорносливу робить цю першу страву цікавішою.",
    "image": "images/borsch-klassicheskiy-so-smetanoy.jpg",
    "author": 1,
    "date_created": "2026-10-27T11:51:01.975Z",
    "category": 3
  }
},
